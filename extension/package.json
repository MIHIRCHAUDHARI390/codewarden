{
  "name": "codewarden",
  "displayName": "CodeWarden Security Guard",
  "description": "Scans Python code for security bugs and proposes sandbox-verified patches.",
  "version": "0.1.0",
  "publisher": "codewarden",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Linters"],
  "main": "./out/extension.js",
  "icon": "media/icon.png",
  "activationEvents": [
    "onLanguage:python",
    "workspaceContains:requirements.txt",
    "onView:codewarden.findingsView",
    "onView:codewarden.statusView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codewarden-sidebar",
          "title": "CodeWarden",
          "icon": "media/shield.svg"
        }
      ]
    },
    "views": {
      "codewarden-sidebar": [
        {
          "id": "codewarden.findingsView",
          "name": "Security Findings"
        },
        {
          "id": "codewarden.statusView",
          "name": "Guard Status"
        }
      ]
    },
    "commands": [
      {
        "command": "securityGuard.scanFile",
        "title": "Security Guard: Scan Active File",
        "category": "CodeWarden"
      },
      {
        "command": "securityGuard.scanWorkspace",
        "title": "Security Guard: Scan Workspace",
        "icon": "$(refresh)",
        "category": "CodeWarden"
      },
      {
        "command": "securityGuard.generatePatch",
        "title": "Security Guard: Generate Verified Patch",
        "icon": "$(tools)",
        "category": "CodeWarden"
      },
      {
        "command": "securityGuard.patchFromTree",
        "title": "Generate Verified Patch",
        "icon": "$(tools)"
      },
      {
        "command": "securityGuard.openFinding",
        "title": "Open Finding in Editor"
      },
      {
        "command": "securityGuard.refreshStatus",
        "title": "Refresh Guard Status",
        "icon": "$(sync)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "securityGuard.scanWorkspace",
          "when": "view == codewarden.findingsView",
          "group": "navigation"
        },
        {
          "command": "securityGuard.refreshStatus",
          "when": "view == codewarden.statusView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "securityGuard.patchFromTree",
          "when": "viewItem == findingItem",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Security Guard",
      "properties": {
        "securityGuard.backendUrl": { "type": "string", "default": "http://127.0.0.1:8765" },
        "securityGuard.apiKey": { "type": "string", "default": "", "description": "Mistral API key. If left blank, uses MISTRAL_API_KEY environment variable on backend." },
        "securityGuard.scanOnSave": { "type": "boolean", "default": true },
        "securityGuard.model": { "type": "string", "default": "", "description": "Mistral model id. Empty = backend default (codestral-latest)." },
        "securityGuard.maxRetries": { "type": "number", "default": 3 },
        "securityGuard.severityThreshold": { "type": "string", "enum": ["low", "medium", "high", "critical"], "default": "low" }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}
